{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibe Evals Evidence Requests v1",
  "type": "object",
  "required": ["schema_version", "base_package_id", "requests"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "base_package_id": {"type": "string", "minLength": 1},
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["request_id", "model_id", "rubric_id", "need", "allowed_methods"],
        "properties": {
          "request_id": {"type": "string", "pattern": "^REQ-[0-9]{3,}$"},
          "model_id": {"type": "string", "minLength": 1},
          "rubric_id": {"type": "string", "minLength": 1},
          "round": {"type": "integer", "minimum": 1},
          "need": {"type": "string", "minLength": 1},
          "why_needed": {"type": "string"},
          "current_evidence_ids": {"type": "array", "items": {"type": "string"}},
          "allowed_methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["static_line", "self_test_run", "probe_run", "conversation", "snapshot_diff", "inventory_fact"]}},
          "acceptance": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
